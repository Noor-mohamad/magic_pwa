<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="silent_offer_skus" resource="default" engine="innodb" comment="Silent Offer SKUs">
        <column xsi:type="int" name="entity_id" padding="10" unsigned="true" nullable="false" identity="true" comment="Entity Id"/>
        <column xsi:type="varchar" name="brand_title" nullable="false" length="255" comment="Brand Title"/>
        <column xsi:type="text" name="sku" comment="Skus"/>
        <column xsi:type="timestamp" name="date_from" nullable="true" comment="Date From"/>
        <column xsi:type="timestamp" name="date_to" nullable="true" comment="Date To"/>
        <column xsi:type="timestamp" name="created_at" default="CURRENT_TIMESTAMP" on_update="false" nullable="false" comment="Created At"/>
        <column xsi:type="timestamp" name="updated_at" default="CURRENT_TIMESTAMP" on_update="true" nullable="false" comment="Updated At"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id"/>
        </constraint>
    </table>
</schema>
