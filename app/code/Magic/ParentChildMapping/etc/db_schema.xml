<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="childsku_mapping" resource="default" engine="innodb" comment="Parent Child SKU Mapping">
        <column xsi:type="int" name="id" unsigned="true" nullable="false" identity="true" comment="Primary Key"/>
        <column xsi:type="varchar" name="parent_sku" nullable="true" length="255" comment="Parent SKU"/>
        <column xsi:type="varchar" name="child_sku" nullable="true" length="255" comment="Child SKU"/>
        <column xsi:type="decimal" name="special_price" nullable="false" precision="10" scale="2" default="0" comment="Special Price"/>
        <column xsi:type="date" name="from_date" nullable="true" comment="Price Valid From Date"/>
        <column xsi:type="date" name="to_date" nullable="true" comment="Price Valid To Date"/>
        <column xsi:type="varchar" name="update_price_flag" nullable="true" length="255" default="0" comment="Update Price Flag"/>
        <column xsi:type="timestamp" name="created_at" nullable="false" default="CURRENT_TIMESTAMP" on_update="false" comment="Created Time"/>
        <column xsi:type="timestamp" name="updated_at" nullable="false" default="CURRENT_TIMESTAMP" on_update="true" comment="Updated Time"/>
        <column xsi:type="varchar" name="flag_special_price" nullable="true" length="255" default="0" comment="Flag Special Price"/>
        <column xsi:type="varchar" name="flag_from_date" nullable="true" length="255" default="0" comment="Flagged From Date"/>
        <column xsi:type="varchar" name="flag_to_date" nullable="true" length="255" default="0" comment="Flagged To Date"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="id"/>
        </constraint>
        <constraint xsi:type="unique" referenceId="CHILDSKU_MAPPING_PARENT_SKU_CHILD_SKU">
            <column name="parent_sku"/>
            <column name="child_sku"/>
        </constraint>
    </table>
</schema>
