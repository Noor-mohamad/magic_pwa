<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">

    <!-- Multiple Wishlist main table -->
    <table name="magic_wishlist" resource="default" engine="innodb" comment="Magic Multiple Wishlist">
        <column xsi:type="int" name="wishlist_id" unsigned="true" nullable="false" identity="true" comment="Wishlist ID"/>
        <column xsi:type="int" name="customer_id" unsigned="true" nullable="false" identity="false" default="0" comment="Customer ID"/>
        <column xsi:type="varchar" name="wishlist_name" nullable="false" length="255" default="My Wishlist" comment="Wishlist Name"/>
        <column xsi:type="smallint" name="is_default" unsigned="true" nullable="false" identity="false" default="0" comment="Is Default Wishlist"/>
        <column xsi:type="smallint" name="shared" unsigned="true" nullable="false" identity="false" default="0" comment="Sharing Flag"/>
        <column xsi:type="varchar" name="sharing_code" nullable="true" length="32" comment="Sharing Encrypted Code"/>
        <column xsi:type="timestamp" name="created_at" on_update="false" nullable="false" default="CURRENT_TIMESTAMP" comment="Created At"/>
        <column xsi:type="timestamp" name="updated_at" on_update="true" nullable="false" default="CURRENT_TIMESTAMP" comment="Updated At"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="wishlist_id"/>
        </constraint>
        <constraint xsi:type="foreign" referenceId="MAGIC_WISHLIST_CUSTOMER_ID_CUSTOMER_ENTITY_ENTITY_ID"
                    table="magic_wishlist" column="customer_id"
                    referenceTable="customer_entity" referenceColumn="entity_id" onDelete="CASCADE"/>
        <index referenceId="MAGIC_WISHLIST_CUSTOMER_ID" indexType="btree">
            <column name="customer_id"/>
        </index>
    </table>

    <!-- Wishlist items table -->
    <table name="magic_wishlist_item" resource="default" engine="innodb" comment="Magic Wishlist Items">
        <column xsi:type="int" name="item_id" unsigned="true" nullable="false" identity="true" comment="Item ID"/>
        <column xsi:type="int" name="wishlist_id" unsigned="true" nullable="false" identity="false" default="0" comment="Wishlist ID"/>
        <column xsi:type="int" name="product_id" unsigned="true" nullable="false" identity="false" default="0" comment="Product ID"/>
        <column xsi:type="smallint" name="store_id" unsigned="true" nullable="true" identity="false" comment="Store ID"/>
        <column xsi:type="decimal" name="qty" scale="4" precision="12" unsigned="false" nullable="false" default="1" comment="Quantity"/>
        <column xsi:type="text" name="comment" nullable="true" comment="User Comment on Product"/>
        <column xsi:type="timestamp" name="added_at" on_update="false" nullable="false" default="CURRENT_TIMESTAMP" comment="Added At"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="item_id"/>
        </constraint>
        <constraint xsi:type="foreign" referenceId="MAGIC_WISHLIST_ITEM_WISHLIST_ID_MAGIC_WISHLIST_WISHLIST_ID"
                    table="magic_wishlist_item" column="wishlist_id"
                    referenceTable="magic_wishlist" referenceColumn="wishlist_id" onDelete="CASCADE"/>
        <constraint xsi:type="foreign" referenceId="MAGIC_WISHLIST_ITEM_PRODUCT_ID_CATALOG_PRODUCT_ENTITY_ENTITY_ID"
                    table="magic_wishlist_item" column="product_id"
                    referenceTable="catalog_product_entity" referenceColumn="entity_id" onDelete="CASCADE"/>
        <constraint xsi:type="foreign" referenceId="MAGIC_WISHLIST_ITEM_STORE_ID_STORE_STORE_ID"
                    table="magic_wishlist_item" column="store_id"
                    referenceTable="store" referenceColumn="store_id" onDelete="SET NULL"/>
        <index referenceId="MAGIC_WISHLIST_ITEM_WISHLIST_ID" indexType="btree">
            <column name="wishlist_id"/>
        </index>
        <index referenceId="MAGIC_WISHLIST_ITEM_PRODUCT_ID" indexType="btree">
            <column name="product_id"/>
        </index>
    </table>

    <!-- Price alert table -->
    <table name="magic_wishlist_price_alert" resource="default" engine="innodb" comment="Magic Wishlist Price Alerts">
        <column xsi:type="int" name="alert_id" unsigned="true" nullable="false" identity="true" comment="Alert ID"/>
        <column xsi:type="int" name="customer_id" unsigned="true" nullable="false" identity="false" default="0" comment="Customer ID"/>
        <column xsi:type="int" name="product_id" unsigned="true" nullable="false" identity="false" default="0" comment="Product ID"/>
        <column xsi:type="int" name="wishlist_id" unsigned="true" nullable="false" identity="false" default="0" comment="Wishlist ID"/>
        <column xsi:type="decimal" name="price_at_add" scale="4" precision="12" unsigned="false" nullable="false" default="0" comment="Product Price When Added"/>
        <column xsi:type="timestamp" name="last_sent_at" on_update="false" nullable="true" comment="Last Alert Email Sent At"/>
        <column xsi:type="smallint" name="is_active" unsigned="true" nullable="false" identity="false" default="1" comment="Alert Active Flag"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="alert_id"/>
        </constraint>
        <constraint xsi:type="foreign" referenceId="MAGIC_WISHLIST_PRICE_ALERT_CUSTOMER_ID_CUSTOMER_ENTITY_ENTITY_ID"
                    table="magic_wishlist_price_alert" column="customer_id"
                    referenceTable="customer_entity" referenceColumn="entity_id" onDelete="CASCADE"/>
        <constraint xsi:type="foreign" referenceId="MAGIC_WISHLIST_PRICE_ALERT_PRODUCT_ID_CATALOG_PRODUCT_ENTITY_ENTITY_ID"
                    table="magic_wishlist_price_alert" column="product_id"
                    referenceTable="catalog_product_entity" referenceColumn="entity_id" onDelete="CASCADE"/>
        <constraint xsi:type="foreign" referenceId="MAGIC_WISHLIST_PRICE_ALERT_WISHLIST_ID_MAGIC_WISHLIST_WISHLIST_ID"
                    table="magic_wishlist_price_alert" column="wishlist_id"
                    referenceTable="magic_wishlist" referenceColumn="wishlist_id" onDelete="CASCADE"/>
        <index referenceId="MAGIC_WISHLIST_PRICE_ALERT_CUSTOMER_ID" indexType="btree">
            <column name="customer_id"/>
        </index>
        <index referenceId="MAGIC_WISHLIST_PRICE_ALERT_PRODUCT_ID" indexType="btree">
            <column name="product_id"/>
        </index>
    </table>

</schema>
